# MikroTik RouterOS — PPPoE RB2011 (WifiZone / DYRSIA)
# Ports PPPoE : ether6, ether7  →  bridge-pppoe
# Hotspot : wlan1, ether3  →  bridge-hotspot  (10.10.0.0/24)
# Management : ether2  →  bridge-management
# WAN : ether1
#
# Import : uploadez ce fichier puis  /import file-name=mikrotik-pppoe-setup.rsc
# Si bridge-pppoe existe deja, supprimez ou commentez la section 0 avant import.

# ===== 0. Bridge PPPoE (ports 2, 3, 4, 5) =====
/interface bridge
add name=bridge-pppoe comment="DYRSIA PPPoE LAN"

/interface bridge port
add bridge=bridge-pppoe interface=ether2
add bridge=bridge-pppoe interface=ether3
add bridge=bridge-pppoe interface=ether4
add bridge=bridge-pppoe interface=ether5

/ip address
add address=10.10.10.1/24 interface=bridge-pppoe comment="DYRSIA PPPoE gateway"

# ===== 1. Pool IP clients PPPoE =====
/ip pool
add name=pppoe-pool ranges=10.10.10.2-10.10.10.254 comment="DYRSIA PPPoE clients"

# ===== 2. Profils PPP (noms = name_plan dans l'application) =====
/ppp profile
add name=default local-address=10.10.10.1 remote-address=pppoe-pool comment="DYRSIA default"
add name=EXPIRE local-address=10.10.10.1 remote-address=pppoe-pool rate-limit=128k/128k \
    on-up=":if (\$remote-address!=\"\") do={ /ip firewall address-list add list=pppoe-expired address=\$remote-address comment=\$user }" \
    on-down=":if (\$remote-address!=\"\") do={ /ip firewall address-list remove [find list=pppoe-expired address=\$remote-address] }" \
    comment="DYRSIA forfait expire"

# ===== 3. Serveur PPPoE sur bridge-pppoe =====
/interface pppoe-server server
add service-name=internet interface=bridge-pppoe disabled=no default-profile=default \
    one-session-per-host=yes max-mru=1480 max-mtu=1480 comment="DYRSIA PPPoE server"

# ===== 4. Pare-feu : clients expires = acces portail + paiement seulement =====
# Regles detaillees poussees par DYRSIA (Services > PPPoE > Captive expire)
/ip firewall address-list
add list=pppoe-expired comment="DYRSIA clients PPPoE expires"

# ===== 5. NAT sortant clients PPPoE =====
/ip firewall nat
add chain=srcnat action=masquerade out-interface=ether1 comment="DYRSIA PPPoE NAT"

# ===== 6. API (deja configure via WireGuard 10.0.0.3) =====
# /ip service set api address=10.0.0.0/24 disabled=no
# DYRSIA pousse /ppp/secret et /ppp/profile via API

# ===== TEST MANUEL (optionnel) =====
# /ppp secret add name=test-pppoe password=Test1234 profile=default service=pppoe
# Client : user test-pppoe / pass Test1234 / service-name internet

# ===== CHECKLIST DYRSIA =====
# 1. Reseau > Pools : pppoe-pool, 10.10.10.2-10.10.10.254, local 10.10.10.1, routeur RB2011
# 2. Services > PPPoE : forfaits (12M, 4M…) — plan EXPIRE auto au deploiement
# 3. Clients : pppoe_username / pppoe_password
# 4. Services > PPPoE > Captive expire : deploy firewall + portail
# 5. Cron : */5 * * * * php system/cron.php
