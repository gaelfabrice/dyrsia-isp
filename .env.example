APP_URL=https://your-service.onrender.com
APP_STAGE=Live
APP_KEY=
APP_TIMEZONE=Africa/Douala

DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=dyrsia
DB_USERNAME=dyrsia
DB_PASSWORD=change-me

# FreeRADIUS (optionnel — par défaut = même MySQL que DB_*)
# RADIUS_HOST=127.0.0.1
# RADIUS_DATABASE=wifizones
# RADIUS_USERNAME=root
# RADIUS_PASSWORD=

# Sécurité production
HEALTH_TOKEN=
CRON_TOKEN=
API_SECRET=

# Sauvegarde automatique quotidienne → Telegram
BACKUP_AUTO=yes
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=

# Optionnel : alertes ops Telegram (bot + chat id dans Paramètres → App)

# Déploiement MikroTik depuis l’admin (Docker Apache / mod_php : laisser à 1)
WIFIZONE_HOTSPOT_DEPLOY_INLINE=1
WIFIZONE_PPPOE_DEPLOY_INLINE=1
